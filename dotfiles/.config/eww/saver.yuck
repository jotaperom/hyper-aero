(defpoll saver_hm :interval "2s" "date +%H:%M")
(defpoll saver_date :interval "60s" "__HOME__/.config/hyper-aero/scripts/saver-text.sh date")
(defpoll saver_hint :interval "600s" "__HOME__/.config/hyper-aero/scripts/saver-text.sh hint")

(defwidget saver-clock []
  (box :class "saver-wrap" :orientation "v" :space-evenly false
    (label :class "saver-time" :halign "start" :text saver_hm)
    (label :class "saver-date" :halign "start" :text saver_date)
    (label :class "saver-brand" :halign "start" :text saver_hint)))

(defwindow saver-clock
  :monitor 0
  :geometry (geometry :x "64px" :y "56px" :anchor "bottom left")
  :stacking "overlay"
  :exclusive false
  :focusable false
  :namespace "aerosaver-clock"
  (saver-clock))
