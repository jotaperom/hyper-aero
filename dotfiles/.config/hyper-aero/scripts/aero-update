#!/usr/bin/env bash

. "$HOME/.config/hyper-aero/scripts/i18n.sh"

A="$HOME/.config/hyper-aero"
CACHE="$HOME/.cache/hyper-aero"
STATE="$CACHE/update.json"
mkdir -p "$CACHE"

cur=$(jq -r '.version // ""' "$A/.install.json" 2>/dev/null)
repo=$(jq -r '.repo // ""' "$A/.install.json" 2>/dev/null)
[ -n "$repo" ] && [ "$repo" != null ] || repo="jotaperom/hyper-aero"

newer() {
    [ "$1" = "$2" ] && return 1
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

check() {
    local quiet="$1" info latest url
    if [ "$quiet" = 1 ]; then
        [ "$(jq -r '."update.check" // true' "$A/settings.json" 2>/dev/null)" = false ] && return 0
        if [ -f "$STATE" ] && [ $(( $(date +%s) - $(stat -c %Y "$STATE") )) -lt 72000 ]; then
            return 0
        fi
        sleep 20
    fi
    info=$(curl -fsSL --max-time 15 -H "Accept: application/vnd.github+json" "https://api.github.com/repos/$repo/releases/latest") || {
        [ "$quiet" = 1 ] || echo "$(t "No pude consultar GitHub. Revisá tu conexión.")"
        return 1
    }
    latest=$(printf '%s' "$info" | jq -r '.tag_name // ""' | sed 's/^v//')
    url=$(printf '%s' "$info" | jq -r '.tarball_url // ""')
    [ -n "$latest" ] || return 1
    local is=false
    newer "$latest" "${cur:-0}" && is=true
    local before
    before=$(jq -r '.latest // ""' "$STATE" 2>/dev/null)
    jq -n --arg l "$latest" --arg c "$cur" --arg u "$url" --argjson n "$is" --arg t "$(date +%s)" \
        '{latest: $l, current: $c, url: $u, newer: $n, checked: ($t | tonumber)}' > "$STATE"
    if [ "$is" = true ]; then
        if [ "$quiet" = 1 ]; then
            [ "$before" = "$latest" ] || notify-send -a "HYPER·AERO" "$(tf "HYPER·AERO %s disponible" "$latest")" "$(t "Abrí el Panel de control (SUPER + O) → Sistema para actualizar.")"
        else
            echo "$(tf "Hay una versión nueva: %s (tenés %s)." "$latest" "$cur")"
        fi
    elif [ "$quiet" != 1 ]; then
        echo "$(tf "Estás al día: %s." "$cur")"
    fi
}

install_update() {
    check 0 || exit 1
    local url latest dir
    url=$(jq -r '.url // ""' "$STATE")
    latest=$(jq -r '.latest // ""' "$STATE")
    if [ "$(jq -r '.newer' "$STATE")" != true ]; then
        exit 0
    fi
    dir="$CACHE/update/$latest"
    rm -rf "$dir"
    mkdir -p "$dir"
    echo "$(tf "Descargando HYPER·AERO %s…" "$latest")"
    curl -fL --max-time 300 -o "$dir/src.tar.gz" "$url" || { echo "$(t "Falló la descarga.")"; exit 1; }
    tar -xzf "$dir/src.tar.gz" -C "$dir" || { echo "$(t "El archivo descargado está dañado.")"; exit 1; }
    local src
    src=$(find "$dir" -mindepth 1 -maxdepth 1 -type d | head -n1)
    [ -x "$src/install.sh" ] || { echo "$(t "El archivo descargado está dañado.")"; exit 1; }
    local lang profile lat lon
    lang=$(cat "$A/lang" 2>/dev/null || echo es)
    profile=$(jq -r '.name // "equilibrado"' "$A/profile.json" 2>/dev/null)
    lat=$(jq -r '.lat // empty' "$A/theme/config.json" 2>/dev/null)
    lon=$(jq -r '.lon // empty' "$A/theme/config.json" 2>/dev/null)
    local args=(--yes --lang "$lang" --profile "$profile")
    [ -n "$lat" ] && [ -n "$lon" ] && args+=(--location "$lat" "$lon")
    echo "$(t "Instalando… (tus temas, notas, widgets y user.lua se conservan)")"
    (cd "$src" && ./install.sh "${args[@]}")
}

case "${1:-check}" in
    check)
        if [ "$2" = "--quiet" ]; then check 1; else check 0; fi
        ;;
    install)
        install_update
        ;;
    *)
        echo "uso: aero-update check [--quiet]|install"
        exit 1
        ;;
esac
